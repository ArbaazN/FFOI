      "data": {
        "title": "A Professional Finance Skills Ecosystem.",
        "subtitle": "Not a B-School. Not a Coaching Institute.",
        "description": "<p>Finance Forum of India (FFOI) is India’s structured finance skills ecosystem—designed to bridge the gap between academic learning and core finance roles.</p><p> FFOI focuses on skills training, assessment-led certification, industry validation, and governance-driven credibility, enabling learners, institutions, and employers to make better, faster, and more reliable decisions.</p>",
        "typertextInput": "FFOI exists to solve one core problem",
        "sectionImage": null,
        "problemList": [
          {
            "label": "Degrees alone do not guarantee job-ready finance capability."
          },
          {
            "label": "FFOI does not award standalone degrees."
          },
          {
            "label": "FFOI does not guarantee placements."
          },
          {
            "label": "FFOI enables measurable, assessable, and industry-validated finance skills."
          }
        ],
        "items": [
          {
            "titleInput": "What FFOI Is",
            "list": [
              {
                "label": "Skills-first, role-mapped finance education"
              },
              {
                "label": "Assessment-backed certification (FAAT)"
              },
              {
                "label": "Industry-reviewed curriculum design"
              },
              {
                "label": "Nationally aligned skill pathways"
              },
              {
                "label": "Long-term ecosystem builder"
              }
            ]
          },
          {
            "titleInput": "What FFOI Is Not",
            "list": [
              {
                "label": "A traditional university"
              },
              {
                "label": "A placement or staffing agency"
              },
              {
                "label": "A coaching centre selling short certificates"
              }
            ]
          }
        ],
        "buttons": {
